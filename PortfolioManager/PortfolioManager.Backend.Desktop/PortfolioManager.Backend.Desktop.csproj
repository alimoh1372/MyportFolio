<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="appsettings.Database.Example.jsonc" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="appsettings.Database.Example.jsonc" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Photino.NET" Version="4.0.16" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\PortfolioManage.Backend.Infrastructure.SqliteMigrations\PortfolioManage.Backend.Infrastructure.SqliteMigrations.csproj" />
		<ProjectReference Include="..\PortfolioManage.Backend.Infrastructure.SqlServerMigrations\PortfolioManage.Backend.Infrastructure.SqlServerMigrations.csproj" />
		<ProjectReference Include="..\PortfolioManage.Backend.Infrastructure\PortfolioManage.Backend.Infrastructure.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Content Update="appsettings.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

</Project>
